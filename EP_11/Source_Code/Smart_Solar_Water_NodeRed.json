    {
        "id": "logic_function",
        "type": "function",
        "z": "solar_old_dashboard_flow",
        "name": "คำนวณเงื่อนไขระบบน้ำอุ่น",
        "func": "let boilerTemp = flow.get('boilerTemp') || 0;\nlet panelTemp = flow.get('panelTemp') || 0;\nlet manualHeater = flow.get('manualHeater') || false;\n\nif (msg.topic.includes(\"Boiler Temperature\")) { boilerTemp = parseFloat(msg.payload); flow.set('boilerTemp', boilerTemp); }\nif (msg.topic.includes(\"Panel Temperature\")) { panelTemp = parseFloat(msg.payload); flow.set('panelTemp', panelTemp); }\nif (msg.topic && msg.topic.includes(\"Heater Control\")) { manualHeater = (msg.payload === \"ON\" || msg.payload === true); flow.set('manualHeater', manualHeater); }\n\nconst HYSTERESIS = 2.0;\nconst TEMP_DIFF_ON = 10.0;\nconst BOILER_MAX_TEMP = 60.0;\nconst HEATER_ON_TEMP = 35.0;\nconst HEATER_OFF_TEMP = 45.0;\n\nlet nextPumpState = \"OFF\";\nlet nextHeaterState = \"OFF\";\n\nif (boilerTemp < (BOILER_MAX_TEMP - HYSTERESIS)) {\n    if (panelTemp > (boilerTemp + TEMP_DIFF_ON + HYSTERESIS)) { nextPumpState = \"ON\"; }\n    else if (panelTemp < (boilerTemp + TEMP_DIFF_ON)) { nextPumpState = \"OFF\"; }\n    else { nextPumpState = flow.get('pumpState') || \"OFF\"; }\n} else if (boilerTemp > BOILER_MAX_TEMP) { nextPumpState = \"OFF\"; }\nflow.set('pumpState', nextPumpState);\nlet pumpRunning = (nextPumpState === \"ON\");\n\nif (manualHeater && !pumpRunning) {\n    if (boilerTemp > HEATER_OFF_TEMP) { nextHeaterState = \"OFF\"; }\n    else if (boilerTemp < (HEATER_ON_TEMP - HYSTERESIS)) { nextHeaterState = \"ON\"; }\n    else { nextHeaterState = flow.get('heaterState') || \"OFF\"; }\n} else { nextHeaterState = \"OFF\"; }\nflow.set('heaterState', nextHeaterState);\n\nreturn [\n    { topic: \"SolarHeaterV1/command/Circulation Pump\", payload: nextPumpState },\n    { topic: \"SolarHeaterV1/command/Electric Heater\", payload: nextHeaterState },\n    { payload: nextPumpState === \"ON\" },\n    { payload: nextHeaterState === \"ON\" }\n];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 240,
        "wires": [
            [
                "mqtt_out_pump"
            ],
            [
                "mqtt_out_heater"
            ],
            [
                "ui_text_pump"
            ],
