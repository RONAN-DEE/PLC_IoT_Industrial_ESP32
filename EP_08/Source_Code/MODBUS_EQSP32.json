        "g": "52c82e0b9f1e6375",
        "name": "Raw_Int",
        "func": "\n// แปลง raw data --> ทศนิยม\nvar raw_data = msg.payload[0]; // ข้อมูลที่อ่านได้จาก Modbus จะมาเป็น Array ใน msg.payload\nif (raw_data > 32767) raw_data -= 65536; // จัดการแปลงค่าลบ (Sign Extension สำหรับอินทิเจอร์ 16 บิต)\nmsg.payload = raw_data / 100; // หาร 100 เพื่อนำทศนิยมกลับมา\n\nreturn msg;\n",
